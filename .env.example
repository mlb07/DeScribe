# Your private settings. To use them, make a copy of this file named ".env".
# Until both lines below are filled in, the app runs in free practice mode:
# everything works, but photos turn into sample text instead of being read.

# Your AI key from https://console.anthropic.com (starts with sk-ant-).
# This is the only part that costs money: a few cents per photo.
ANTHROPIC_API_KEY=

# A passcode you choose. Needed once on each phone. It stops anyone else
# on the same network from using your AI key.
APP_PASSCODE=

# Which AI model reads the photos. Sonnet was the most accurate on the card test.
#   claude-sonnet-5-5  recommended (about 1-2 cents a photo)
#   claude-haiku-5-5   cheapest (under half a cent), but made more mistakes it didn't highlight
#   claude-opus-5-5    strongest and priciest
AI_MODEL=claude-sonnet-5-5

# Optional: a stronger model that re-reads a photo only when AI_MODEL marks a word as a guess
# (for example AI_MODEL=claude-haiku-5-5 with AI_CHECK_MODEL=claude-sonnet-5-5). "off" = not used.
AI_CHECK_MODEL=off

# Where DeScribe keeps its Word files. Point it at a folder inside your OneDrive and
# every document syncs there. Leave it empty to keep documents inside the app instead.
SAVE_FOLDER=
